{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchManagers": ["argocd"],
      "pinDigests": true
    },
    {
      "matchManagers": ["argocd"],
      "matchUpdateTypes": ["major"],
      "labels": ["argocd-major-update"]
    }
  ]
}
